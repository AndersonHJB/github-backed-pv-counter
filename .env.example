# Use a fine-grained token restricted to the data repository with Contents: Read and write.
COUNTER_GITHUB_TOKEN=github_pat_replace_me
COUNTER_GITHUB_REPOSITORY=AndersonHJB/github-backed-pv-counter-data
COUNTER_GITHUB_BRANCH=main
COUNTER_GITHUB_DATA_DIRECTORY=data/domains
# Set to 0 only if the hosting platform provides a stricter timeout.
COUNTER_GITHUB_TIMEOUT_MS=8000
COUNTER_GITHUB_MAX_FILE_BYTES=524288

# Required by hash mode for stable, non-reversible visitor IDs.
# Must be at least 32 random bytes. Missing/weak values safely disable hash collection.
COUNTER_IP_HASH_SECRET=

# Local-only option. Data is erased whenever the process restarts.
# COUNTER_STORAGE=memory

# Optional config.json overrides.
# Existing GET calls remain enabled; arbitrary domains remain disabled.
# COUNTER_ALLOW_ALL=false
# COUNTER_ALLOW_GET_HITS=true
# COUNTER_IP_MODE=hash
# Raw mode additionally requires both of these explicit secrets/settings.
# COUNTER_ALLOW_RAW_IPS=false
# COUNTER_IP_STATS_TOKEN=
# COUNTER_RATE_LIMIT_MAX=5
# COUNTER_RATE_LIMIT_WINDOW_MS=60000
# 0 disables the corresponding limiter/cache.
# COUNTER_STATS_RATE_LIMIT_MAX=60
# COUNTER_STATS_CACHE_TTL_MS=0
# COUNTER_MAX_PROJECTS_PER_DOMAIN=100
# COUNTER_MAX_VISITOR_KEYS_PER_DOMAIN=2000
